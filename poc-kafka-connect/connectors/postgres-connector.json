{
  "name": "postgres-source",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.dbname": "mydb",
    "database.user": "postgres",
    "database.password": "postgres",
    "database.include.list": "public",
    "database.server.name": "pg-source",
    "database.server.id": "18455",
    "database.server.time.zone": "UTC",
    "database.partition.max.bytes": "104857600",
    "database.partition.max.records": "100000",
    "database.events.max.count": "null",
    "database.events.max.interval": "300000",
    "database.history": "io.debezium.connector.postgresql_history.FileDatabaseHistory",
    "database.history.filename": "/var/lib/kafkaconnect/dbhistory.pb",
    "database.history.file.properties.file.storage.directory": "/var/lib/kafkaconnect",
    "plugin.name": "pgoutput",
    "plugin.list": "org.postgresql.replication.pgoutput.PostgresOutputPlugin;org.postgresql.replication.sls.PostgresSlotStatusPlugin;org.postgresql.replication.wal2stream.Wal2StreamingPlugin",
    "plugin.version": "1.3.2",
    "publication.name": "pg_publication",
    "publication.include.publication": "true",
    "schema.history.internal": "io.debezium.storage.schemahistory.InternalImpl",
    "schema.history.internal.file.filename": "/var/lib/kafkaconnect/schemahistory.pb",
    "schema.history.internal.file.codec": "protobuf",
    "schema.history.internal.storage.type": "file",
    "offset.storage.topic": "postgres_offsets",
    "offset.storage.replication.factor": "1",
    "offset.storage.replication.max.retries": "5",
    "offset.storage.replication.retry.backoff": "5000",
    "offset.flush.interval.ms": "60000",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter.schemas.enable": "false",
    "transforms": "FilterTimestamp",
    "transforms.type": "org.apache.kafka.connect.transforms.FilterTimestamp",
    "transforms.spec": "drop.timestamp()"
  }
}
